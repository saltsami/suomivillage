# Reproducible local default: no external APIs and no model download required.
ENV=dev

# PostgreSQL
POSTGRES_USER=koivulahti
POSTGRES_PASSWORD=koivulahti
POSTGRES_DB=koivulahti
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis and queues
REDIS_URL=redis://redis:6379/0
RENDER_QUEUE=render_jobs
DECISION_QUEUE=decision_jobs

# Simulation
SIM_SEED=1234
SIM_TICK_MS=1000
IMPACT_THRESHOLD_FEED=0.6
IMPACT_THRESHOLD_CHAT=0.4
IMPACT_THRESHOLD_NEWS=0.8

# Safe default: deterministic fake renderer. Set llama_cpp for CPU/GPU profiles.
LLM_PROVIDER=fake
LLM_SERVER_URL=http://llm-server-cpu:8080
LLM_MODEL_PATH=/models/qwen2.5-7b-instruct-q4_k_m.gguf
LLM_CONTEXT=4096
LLM_THREADS=8
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_SERVER_IMAGE_CPU=ghcr.io/ggml-org/llama.cpp:server
LLM_SERVER_IMAGE_GPU=ghcr.io/ggml-org/llama.cpp:server-cuda

# External NPC decision provider is opt-in (`./dev.sh up-decision`).
DECISION_SERVICE_ENABLED=false
DECISION_MIN_INTERVAL=10.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Real-world ambient inputs are outside the deterministic pilot by default.
AMBIENT_REGION=Keski-Suomi
AMBIENT_POLL_SECONDS=3600
AMBIENT_WEATHER_ENABLED=false
AMBIENT_NEWS_ENABLED=false
AMBIENT_SPORTS_ENABLED=false

# Host exposure. Base compose publishes only the API on loopback.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only with infra/docker-compose.dev.yml.
DEV_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
GATEWAY_PORT=8081
LLM_SERVER_PORT=8080
